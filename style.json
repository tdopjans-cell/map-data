{
  "version": 8,
  "name": "Minimal",
  "sources": {
    "eu_countries": {
      "type": "geojson",
      "data": "./europe.json"
    },
    "de_states": {
      "type": "geojson",
      "data": "./germany.json"
    }
  },
  "layers": [
    {
      "id": "bg",
      "type": "background",
      "paint": { "background-color": "#ffffff" }
    },

    {
      "id": "eu-countries-fill",
      "type": "fill",
      "source": "eu_countries",
      "layout": { "visibility": "visible" },
      "paint": { "fill-color": "#000000", "fill-opacity": 0.03 }
    },
    {
      "id": "eu-countries-line",
      "type": "line",
      "source": "eu_countries",
      "layout": { "visibility": "visible" },
      "paint": { "line-color": "#111111", "line-width": 1 }
    },

    {
      "id": "de-states-fill",
      "type": "fill",
      "source": "de_states",
      "layout": { "visibility": "none" },
      "paint": { "fill-color": "#000000", "fill-opacity": 0.03 }
    },
    {
      "id": "de-states-line",
      "type": "line",
      "source": "de_states",
      "layout": { "visibility": "none" },
      "paint": { "line-color": "#111111", "line-width": 1 }
    }
  ]
}


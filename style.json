{
  "version": 8,
  "name": "Way2goX NE2 + Europe + Germany",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "ne2": {
      "type": "raster",
      "tiles": ["./tiles/ne2png/{z}/{x}/{y}.png?v=1"],
      "tileSize": 256,
      "maxzoom": 5,
      "scheme": "tms",
      "attribution": "Natural Earth II"
    },
    "search_selection": {
      "type": "geojson",
      "data": { "type": "FeatureCollection", "features": [] }
    },
    "eu_country_points": {
      "type": "geojson",
      "data": "./europe_inner_points.json"
    },
    "eu_countries": {
      "type": "geojson",
      "data": "./europe_detailed.json",
      "promoteId": "ISO_A2"
    },

    "de_states": {
      "type": "geojson",
      "data": "./germany_detailed.json",
      "promoteId": "iso_3166_2"
    },

    "de_state_points": {
      "type": "geojson",
      "data": "./germany_inner_points.json"
    },

    "de_places": {
      "type": "geojson",
      "data": "./de_places.json",
      "promoteId": "id"
    },

    "flags": {
      "type": "geojson",
      "data": { "type": "FeatureCollection", "features": [] }
    }
  },

  "layers": [
    {
      "id": "bg",
      "type": "background",
      "paint": { "background-color": "#ffffff" }
    },

    {
      "id": "ne2",
      "type": "raster",
      "source": "ne2",
      "paint": {
        "raster-opacity": 1,
        "raster-resampling": "linear"
      }
    },

    {
      "id": "eu-countries-fill",
      "type": "fill",
      "source": "eu_countries",
      "layout": { "visibility": "visible" },
      "paint": {
        "fill-color": [
          "case",
          ["boolean", ["feature-state", "selected"], false], "#ffffff",
          ["boolean", ["feature-state", "hover"], false], "#ffffff",
          "#efe7d6"
        ],
        "fill-opacity": [
          "case",
          ["boolean", ["feature-state", "selected"], false], 0.22,
          ["boolean", ["feature-state", "hover"], false], 0.12,
          0.06
        ]
      }
    },
    {
      "id": "eu-countries-line",
      "type": "line",
      "source": "eu_countries",
      "layout": { "visibility": "visible" },
      "paint": {
        "line-color": "rgba(20,20,20,0.45)",
        "line-width": 1
      }
    },
    {
      "id": "eu-country-labels",
      "type": "symbol",
      "source": "eu_country_points",
      "layout": {
        "visibility": "visible",
        "symbol-placement": "point",
        "text-field": ["coalesce", ["get", "NAME_DE"], ["get", "name_de"], ["get", "NAME"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-anchor": "top",
        "text-offset": [0, 0.6],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#1b1b1b",
        "text-halo-color": "rgba(255,255,255,0.9)",
        "text-halo-width": 1
      }
    },

    {
      "id": "de-states-fill",
      "type": "fill",
      "source": "de_states",
      "layout": { "visibility": "none" },
      "paint": {
        "fill-color": [
          "case",
          ["boolean", ["feature-state", "selected"], false], "#ffffff",
          ["boolean", ["feature-state", "hover"], false], "#ffffff",
          "#efe7d6"
        ],
        "fill-opacity": [
          "case",
          ["boolean", ["feature-state", "selected"], false], 0.22,
          ["boolean", ["feature-state", "hover"], false], 0.12,
          0.06
        ]
      }
    },
    {
      "id": "de-states-line",
      "type": "line",
      "source": "de_states",
      "layout": { "visibility": "none" },
      "paint": {
        "line-color": "rgba(20,20,20,0.6)",
        "line-width": 1
      }
    },
      {
      "id": "de-state-labels",
      "type": "symbol",
      "source": "de_state_points",
      "maxzoom": 6.6,
      "layout": {
        "visibility": "none",
        "symbol-placement": "point",
        "text-field": ["coalesce", ["get", "NAME_DE"], ["get", "NAME"], ["get", "name_de"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-anchor": "top",
        "text-offset": [0, 0.6],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#111111",
        "text-halo-color": "rgba(255,255,255,0.95)",
        "text-halo-width": 2
      }
    },
    {
      "id": "de-places-hitbox",
      "type": "circle",
      "source": "de_places",
      "minzoom": 6.7,
      "layout": { "visibility": "none" },
      "paint": {
        "circle-radius": [
          "interpolate", ["linear"], ["zoom"],
          5, 10,
          7, 16,
          10, 22
        ],
        "circle-color": [
          "case",
          ["boolean", ["feature-state", "selected"], false], "rgba(255,255,255,0.95)",
          ["boolean", ["feature-state", "hover"], false], "rgba(255,255,255,0.85)",
          "rgba(255,255,255,0.55)"
        ],
        "circle-stroke-color": "rgba(0,0,0,0.20)",
        "circle-stroke-width": 1,
        "circle-blur": 0.6
      }
    },
    {
      "id": "de-places-dot",
      "type": "circle",
      "source": "de_places",
      "minzoom": 6.7,
      "layout": { "visibility": "none" },
      "paint": {
        "circle-radius": 3,
        "circle-color": "rgba(0,0,0,0.75)"
      }
    },
      {
      "id": "de-place-labels",
      "type": "symbol",
      "source": "de_places",
      "minzoom": 6.7,
      "layout": {
        "visibility": "none",
        "text-field": ["coalesce", ["get", "name_de"], ["get", "NAME_DE"], ["get", "name"], ["get", "NAME"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-letter-spacing": 0.03,
        "text-allow-overlap": true,
        "text-ignore-placement": true,
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "rgba(10,10,10,0.85)",
        "text-halo-color": "rgba(255,255,255,0.98)",
        "text-halo-width": 1.2
      }
    },
        "layout": {
          "icon-image": "search-flag",
          "icon-size": ["interpolate", ["linear"], ["zoom"],
            4, 0.10,
            7, 0.12,
            10, 0.14,
            13, 0.16
          ],
          "icon-allow-overlap": true,
          "icon-anchor": "bottom",
          "icon-rotation-alignment": "viewport"
        },
       {
      "id": "search-selection-label",
      "type": "symbol",
      "source": "search_selection",
      "layout": {
        "text-field": ["get", "name"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 7, 11, 10, 13, 13, 14],
        "text-offset": [0, 0.8],
        "text-anchor": "top",
        "text-allow-overlap": true
      },
      "paint": {
        "text-color": "#0b2220",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    },
    {
      "id": "flags",
      "type": "symbol",
      "source": "flags",
      "layout": {
        "visibility": "visible",
        "icon-image": ["match", ["get", "role"], "start", "flag-start", "stop", "flag-stop", "end", "flag-end", "flag-stop"],
        "icon-size": 0.18,
        "icon-allow-overlap": true,
        "icon-ignore-placement": true
      },
      "paint": { "icon-opacity": 0.95 }
    }
  ]
}











































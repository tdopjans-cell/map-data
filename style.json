{
  "version": 8,
  "name": "Way2goX NE2 + Europe + Germany",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "ne2": {
      "type": "raster",
      "tiles": ["./tiles/ne2png/{z}/{x}/{y}.png?v=1"],
      "tileSize": 256,
      "maxzoom": 5,
      "scheme": "tms",
      "attribution": "Natural Earth II"
    },

    "eu_countries": {
      "type": "geojson",
      "data": "./europe.json",
      "promoteId": "ISO_A2"
    },

    "de_states": {
      "type": "geojson",
      "data": "./germany.json",
      "promoteId": "iso_3166_2"
    },

    "de_state_points": {
      "type": "geojson",
      "data": "./germany_inner_points.json"
    },

    "de_places": {
      "type": "geojson",
      "data": "./de_places.json"
    },

    "flags": {
      "type": "geojson",
      "data": { "type": "FeatureCollection", "features": [] }
    }
  },

  "layers": [
    {
      "id": "bg",
      "type": "background",
      "paint": { "background-color": "#ffffff" }
    },

    {
      "id": "ne2",
      "type": "raster",
      "source": "ne2",
      "paint": {
        "raster-opacity": 1,
        "raster-resampling": "linear"
      }
    },

    {
      "id": "eu-countries-fill",
      "type": "fill",
      "source": "eu_countries",
      "layout": { "visibility": "visible" },
      "paint": {
        "fill-color": [
          "case",
          ["boolean", ["feature-state", "selected"], false], "#ffffff",
          ["boolean", ["feature-state", "hover"], false], "#ffffff",
          "#efe7d6"
        ],
        "fill-opacity": [
          "case",
          ["boolean", ["feature-state", "selected"], false], 0.22,
          ["boolean", ["feature-state", "hover"], false], 0.12,
          0.06
        ]
      }
    },
    {
      "id": "eu-countries-line",
      "type": "line",
      "source": "eu_countries",
      "layout": { "visibility": "visible" },
      "paint": {
        "line-color": "rgba(20,20,20,0.45)",
        "line-width": 1
      }
    },
    {
      "id": "eu-country-labels",
      "type": "symbol",
      "source": "eu_countries",
      "layout": {
        "visibility": "visible",
        "symbol-placement": "point",
        "text-field": ["coalesce", ["get", "NAME_DE"], ["get", "NAME"], ["get", "name_de"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#1b1b1b",
        "text-halo-color": "rgba(255,255,255,0.9)",
        "text-halo-width": 1
      }
    },

    {
      "id": "de-states-fill",
      "type": "fill",
      "source": "de_states",
      "layout": { "visibility": "none" },
      "paint": {
        "fill-color": [
          "case",
          ["boolean", ["feature-state", "selected"], false], "#ffffff",
          ["boolean", ["feature-state", "hover"], false], "#ffffff",
          "#efe7d6"
        ],
        "fill-opacity": [
          "case",
          ["boolean", ["feature-state", "selected"], false], 0.22,
          ["boolean", ["feature-state", "hover"], false], 0.12,
          0.06
        ]
      }
    },
    {
      "id": "de-states-line",
      "type": "line",
      "source": "de_states",
      "layout": { "visibility": "none" },
      "paint": {
        "line-color": "rgba(20,20,20,0.6)",
        "line-width": 1
      }
    },
    {
      "id": "de-state-labels",
      "type": "symbol",
      "source": "de_state_points",
      "layout": {
        "visibility": "none",
        "symbol-placement": "point",
        "text-field": ["coalesce", ["get", "NAME_DE"], ["get", "NAME"], ["get", "name_de"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#1b1b1b",
        "text-halo-color": "rgba(255,255,255,0.9)",
        "text-halo-width": 1
      }
    },
       {
      "id": "de-places-hitbox",
      "type": "circle",
      "source": "de_places",
      "layout": { "visibility": "none" },
      "paint": {
        "circle-radius": 18,
        "circle-color": "#000000",
        "circle-opacity": 0.001
      }
    },
    {
      "id": "de-places-dot",
      "type": "circle",
      "source": "de_places",
      "layout": { "visibility": "none" },
      "paint": {
        "circle-radius": [
          "case",
          ["boolean", ["feature-state", "selected"], false], 6,
          ["boolean", ["feature-state", "hover"], false], 6,
          4
        ],
        "circle-color": [
          "case",
          ["boolean", ["feature-state", "selected"], false], "#111111",
          ["boolean", ["feature-state", "hover"], false], "#111111",
          "#111111"
        ],
        "circle-stroke-color": [
          "case",
          ["boolean", ["feature-state", "selected"], false], "#ffffff",
          ["boolean", ["feature-state", "hover"], false], "#ffffff",
          "rgba(255,255,255,0.8)"
        ],
        "circle-stroke-width": [
          "case",
          ["boolean", ["feature-state", "selected"], false], 2,
          ["boolean", ["feature-state", "hover"], false], 2,
          1
        ],
        "circle-opacity": 0.95
      }
    },
    {
      "id": "de-place-labels",
      "type": "symbol",
      "source": "de_places",
      "layout": {
        "visibility": "none",
        "text-field": ["coalesce", ["get", "name_de"], ["get", "NAME_DE"], ["get", "name"], ["get", "NAME"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-offset": [0, 1.1],
        "text-anchor": "top",
        "text-allow-overlap": true,
        "text-ignore-placement": true
      },
      "paint": {
        "text-color": "#111111",
        "text-halo-color": [
          "case",
          ["boolean", ["feature-state", "selected"], false], "rgba(255,255,255,1)",
          ["boolean", ["feature-state", "hover"], false], "rgba(255,255,255,1)",
          "rgba(255,255,255,0.95)"
        ],
        "text-halo-width": [
          "case",
          ["boolean", ["feature-state", "selected"], false], 3,
          ["boolean", ["feature-state", "hover"], false], 3,
          2
        ],
        "text-halo-blur": 0.6,
    
        "text-background-color": [
          "case",
          ["boolean", ["feature-state", "selected"], false], "rgba(255,255,255,0.95)",
          ["boolean", ["feature-state", "hover"], false], "rgba(255,255,255,0.90)",
          "rgba(255,255,255,0.75)"
        ],
        "text-background-padding": [8, 6],
        "text-background-border-radius": 999
      }
    },

    {
      "id": "flags",
      "type": "symbol",
      "source": "flags",
      "layout": {
        "visibility": "visible",
        "icon-image": ["match", ["get", "role"], "start", "flag-start", "stop", "flag-stop", "end", "flag-end", "flag-stop"],
        "icon-size": 0.18,
        "icon-allow-overlap": true,
        "icon-ignore-placement": true
      },
      "paint": { "icon-opacity": 0.95 }
    }
  ]
}


































